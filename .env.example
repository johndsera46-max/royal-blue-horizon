# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Neon, Vercel Postgres, Fly Postgres, etc.)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string — signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSION_SECRET=

# Used only by scripts/seed-admin.mjs to create/update the single admin login.
# Not read by the app itself at runtime.
ADMIN_EMAIL=
ADMIN_PASSWORD=
